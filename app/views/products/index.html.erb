<h1 class="text-2xl font-bold text-slate-900">Products</h1>

<ul class="mt-6 space-y-4">
  <% @products.each do |product| %>
    <li class="rounded-lg border border-slate-200 bg-white p-4 flex items-center justify-between">
      <div>
        <%= link_to product.name, product, class: "font-semibold text-slate-900 hover:underline" %>
        <p class="text-sm text-slate-500">&euro;<%= "%.2f" % product.price %></p>
      </div>
      <% unless product.purchasable? %>
        <span class="text-xs text-slate-400">Not for sale yet</span>
      <% end %>
    </li>
  <% end %>
</ul>
