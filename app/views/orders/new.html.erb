<h1 class="text-2xl font-bold text-slate-900">Checkout &mdash; <%= @product.name %></h1>
<p class="mt-1 text-slate-600">&euro;<%= "%.2f" % @product.price %> each</p>

<%= form_with url: orders_path, method: :post, data: { turbo: false }, class: "mt-8 space-y-4" do |f| %>
  <%= f.hidden_field :product_id, value: @product.id %>

  <div>
    <%= f.label :guest_first_name, "First name", class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :guest_first_name, required: true, class: "mt-1 block w-full rounded-md border border-slate-300" %>
  </div>

  <div>
    <%= f.label :guest_last_name, "Last name", class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :guest_last_name, required: true, class: "mt-1 block w-full rounded-md border border-slate-300" %>
  </div>

  <div>
    <%= f.label :guest_email, "Email", class: "block text-sm font-medium text-slate-700" %>
    <%= f.email_field :guest_email, required: true, class: "mt-1 block w-full rounded-md border border-slate-300" %>
  </div>

  <div>
    <%= f.label :quantity, class: "block text-sm font-medium text-slate-700" %>
    <%= f.number_field :quantity, value: 1, min: 1, class: "mt-1 block w-24 rounded-md border border-slate-300" %>
  </div>

  <%= f.submit "Go to payment", class: "rounded-lg bg-slate-900 px-5 py-2.5 text-white font-semibold hover:bg-slate-700 cursor-pointer" %>
<% end %>
